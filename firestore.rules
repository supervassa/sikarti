rules_version = '2';

// users/{uid}: private authentication profile (admin, wb, pengajar all live here).
// admins/{uid}: the restricted directory that superadmin uses to manage admin accounts.
// auditLogs/{id}: append-only activity records; only superadmin may read them.
// subjects/schedules/presensi/invoices/registrations: operasional data admin & superadmin kelola.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isSuperadmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != false;
    }
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != false;
    }
    function isStaff() { return isSuperadmin() || isAdmin(); }
    function isPengajar() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pengajar'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != false;
    }
    // Dipakai supaya pengajar bisa baca presensi WB khusus untuk sesi kelas yang dia mulai sendiri
    // (roster kehadiran di Jadwal Mengajar), bukan presensi WB di kelas orang lain.
    function isPengajarOfSession(sessionId) {
      return isPengajar()
        && get(/databases/$(database)/documents/classSessions/$(sessionId)).data.pengajarId == request.auth.uid;
    }
    function isRecentServerTime(value) {
      return value is timestamp && value == request.time;
    }
    function isValidAdminProfile(data) {
      return data.keys().hasOnly(['email', 'nama', 'username', 'role', 'kd_role', 'status', 'createdAt', 'updatedAt', 'lastLogin'])
        && data.keys().hasAll(['email', 'nama', 'username', 'role', 'kd_role', 'status', 'createdAt', 'updatedAt', 'lastLogin'])
        && data.email is string && data.email.size() > 4 && data.email.size() <= 254
        && data.nama is string && data.nama.size() > 1 && data.nama.size() <= 100
        && data.username is string && data.username.size() > 1 && data.username.size() <= 50
        && data.role == 'admin' && data.kd_role == 11 && data.status is bool
        && isRecentServerTime(data.createdAt) && isRecentServerTime(data.updatedAt)
        && data.lastLogin == null;
    }
    // Status WB 3-state: AKTIF, NONAKTIF (wajib catat terakhirAktif), LULUS (wajib catat tahunLulus).
    // Field tahun yang tidak relevan dengan status saat ini wajib TIDAK ADA (dibersihkan via deleteField()
    // di setWBLifecycleStatus) supaya data tidak basi saat status berpindah lagi.
    // Bentuk dokumen WB dipisah dari cek waktu server supaya bisa dipakai ulang untuk create
    // (createdAt/updatedAt harus baru) maupun edit (createdAt dikunci di pemanggil).
    function isValidWBProfileShape(data) {
      return data.keys().hasAll(['nama', 'email', 'role', 'kd_role', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['nama', 'email', 'emailKontak', 'nomorInduk', 'paket', 'nik', 'noHp', 'tahunAngkatan', 'tahunLulus', 'terakhirAktif', 'role', 'kd_role', 'status', 'createdAt', 'updatedAt', 'lastLogin', 'nisn', 'jenisKelamin', 'agama', 'tempatLahir', 'tanggalLahir', 'alamat', 'sekolahAsal', 'namaAyah', 'namaIbu', 'tingkat', 'nis'])
        && data.nama is string && data.nama.size() > 1 && data.nama.size() <= 100
        && data.email is string && data.email.size() > 4 && data.email.size() <= 254
        && data.role == 'wb' && data.kd_role == 22 && data.status in ['AKTIF', 'NONAKTIF', 'LULUS']
        // Nomor Induk = kredensial login WB (dipetakan ke synthetic email di client). Opsional di
        // shape supaya edit WB lama (belum punya) tidak pecah; kehadirannya diwajibkan di allow create.
        && (!('nomorInduk' in data.keys()) || (data.nomorInduk is string && data.nomorInduk.size() >= 6 && data.nomorInduk.size() <= 20))
        && (!('emailKontak' in data.keys()) || (data.emailKontak is string && data.emailKontak.size() <= 254))
        && (!('paket' in data.keys()) || data.paket in ['Paket A', 'Paket B', 'Paket C'])
        && (!('tahunAngkatan' in data.keys()) || (data.tahunAngkatan is string && data.tahunAngkatan.size() <= 20))
        && (!('nik' in data.keys()) || (data.nik is string && data.nik.size() <= 30))
        && (!('noHp' in data.keys()) || (data.noHp is string && data.noHp.size() <= 30))
        // Data diri lengkap (dari impor Dapodik / form admin). Semua opsional & string pendek.
        && (!('nisn' in data.keys()) || (data.nisn is string && data.nisn.size() <= 30))
        && (!('jenisKelamin' in data.keys()) || (data.jenisKelamin is string && data.jenisKelamin.size() <= 20))
        && (!('agama' in data.keys()) || (data.agama is string && data.agama.size() <= 20))
        && (!('tempatLahir' in data.keys()) || (data.tempatLahir is string && data.tempatLahir.size() <= 60))
        && (!('tanggalLahir' in data.keys()) || (data.tanggalLahir is string && data.tanggalLahir.size() <= 20))
        && (!('alamat' in data.keys()) || (data.alamat is string && data.alamat.size() <= 300))
        && (!('sekolahAsal' in data.keys()) || (data.sekolahAsal is string && data.sekolahAsal.size() <= 120))
        && (!('namaAyah' in data.keys()) || (data.namaAyah is string && data.namaAyah.size() <= 100))
        && (!('namaIbu' in data.keys()) || (data.namaIbu is string && data.namaIbu.size() <= 100))
        && (!('tingkat' in data.keys()) || (data.tingkat is string && data.tingkat.size() <= 10))
        && (!('nis' in data.keys()) || (data.nis is string && data.nis.size() <= 30))
        && (data.status == 'LULUS'
            ? (data.tahunLulus is string && data.tahunLulus.size() > 0 && data.tahunLulus.size() <= 20)
            : !('tahunLulus' in data.keys()))
        && (data.status == 'NONAKTIF'
            ? (data.terakhirAktif is string && data.terakhirAktif.size() > 0 && data.terakhirAktif.size() <= 20)
            : !('terakhirAktif' in data.keys()));
    }
    function isValidWBProfile(data) {
      return isValidWBProfileShape(data) && isRecentServerTime(data.createdAt) && isRecentServerTime(data.updatedAt);
    }
    function isValidPengajarProfileShape(data) {
      return data.keys().hasAll(['nama', 'email', 'role', 'kd_role', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['nama', 'email', 'mapelDiampu', 'noHp', 'role', 'kd_role', 'status', 'createdAt', 'updatedAt', 'lastLogin'])
        && data.nama is string && data.nama.size() > 1 && data.nama.size() <= 100
        && data.email is string && data.email.size() > 4 && data.email.size() <= 254
        && data.role == 'pengajar' && data.kd_role == 33 && data.status is bool
        && (!('mapelDiampu' in data.keys()) || (data.mapelDiampu is string && data.mapelDiampu.size() <= 100))
        && (!('noHp' in data.keys()) || (data.noHp is string && data.noHp.size() <= 30));
    }
    function isValidPengajarProfile(data) {
      return isValidPengajarProfileShape(data) && isRecentServerTime(data.createdAt) && isRecentServerTime(data.updatedAt);
    }
    // Profil minimal calon WB (pra-aktivasi) yang ditulis sendiri saat submit formulir.
    function isValidCalonWBProfile(data) {
      return data.keys().hasOnly(['nama', 'email', 'role', 'kd_role', 'status', 'registrationId', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['nama', 'email', 'role', 'kd_role', 'status', 'registrationId', 'createdAt', 'updatedAt'])
        && data.nama is string && data.nama.size() > 1 && data.nama.size() <= 100
        && data.email is string && data.email.size() > 4 && data.email.size() <= 254
        && data.role == 'calon_wb' && data.kd_role == 21 && data.status == true
        && data.registrationId == request.auth.uid
        && isRecentServerTime(data.createdAt) && isRecentServerTime(data.updatedAt);
    }
    // Admin/superadmin mempromosikan calon_wb menjadi wb saat aktivasi (uid tetap sama).
    function isValidCalonToWBActivation() {
      return resource.data.role == 'calon_wb'
        && request.resource.data.role == 'wb'
        && request.resource.data.kd_role == 22
        && request.resource.data.status == 'AKTIF'
        && request.resource.data.createdAt == resource.data.createdAt
        && isRecentServerTime(request.resource.data.updatedAt)
        && request.resource.data.keys().hasOnly(['nama', 'email', 'paket', 'nik', 'noHp', 'tahunAngkatan', 'role', 'kd_role', 'status', 'createdAt', 'updatedAt', 'lastLogin'])
        && request.resource.data.keys().hasAll(['nama', 'email', 'paket', 'role', 'kd_role', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.nama is string && request.resource.data.nama.size() > 1 && request.resource.data.nama.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() > 4
        && request.resource.data.paket in ['Paket A', 'Paket B', 'Paket C']
        && request.resource.data.tahunAngkatan is string && request.resource.data.tahunAngkatan.size() <= 20
        && (!('nik' in request.resource.data.keys()) || request.resource.data.nik is string)
        && (!('noHp' in request.resource.data.keys()) || request.resource.data.noHp is string);
    }
    // Admin/superadmin mengedit profil WB atau Pengajar (data diri + status aktif/nonaktif).
    // role/kd_role/createdAt dikunci agar tidak bisa diubah lewat jalur update biasa.
    function isValidWBOrPengajarEdit() {
      return isStaff()
        && resource.data.role in ['wb', 'pengajar']
        && request.resource.data.role == resource.data.role
        && request.resource.data.kd_role == resource.data.kd_role
        && request.resource.data.createdAt == resource.data.createdAt
        && isRecentServerTime(request.resource.data.updatedAt)
        && (
          (resource.data.role == 'wb' && isValidWBProfileShape(request.resource.data))
          || (resource.data.role == 'pengajar' && isValidPengajarProfileShape(request.resource.data))
        );
    }
    function isValidAdminDirectory(uid, data) {
      return data.keys().hasOnly(['uid', 'email', 'nama', 'username', 'role', 'status', 'createdAt', 'updatedAt', 'lastLogin'])
        && data.keys().hasAll(['uid', 'email', 'nama', 'username', 'role', 'status', 'createdAt', 'updatedAt', 'lastLogin'])
        && data.uid == uid && data.email is string && data.email.size() > 4 && data.email.size() <= 254
        && data.nama is string && data.nama.size() > 1 && data.nama.size() <= 100
        && data.username is string && data.username.size() > 1 && data.username.size() <= 50
        && data.role == 'admin' && data.status is bool
        && isRecentServerTime(data.createdAt) && isRecentServerTime(data.updatedAt)
        && data.lastLogin == null;
    }
    function isValidAdminStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status is bool && isRecentServerTime(request.resource.data.updatedAt)
        && resource.data.role in ['admin', 'superadmin'] && request.resource.data.role == resource.data.role;
    }
    // Superadmin menaikkan admin -> superadmin atau menurunkan superadmin -> admin.
    // Tidak boleh mengubah role akun sendiri, jadi selalu tersisa minimal satu superadmin.
    function isValidAdminRoleChange(uid) {
      return uid != request.auth.uid
        && resource.data.role in ['admin', 'superadmin']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'kd_role', 'updatedAt'])
        && request.resource.data.role in ['admin', 'superadmin']
        && request.resource.data.role != resource.data.role
        && (request.resource.data.role == 'superadmin'
            ? request.resource.data.kd_role == 99
            : request.resource.data.kd_role == 11)
        && isRecentServerTime(request.resource.data.updatedAt);
    }
    function isValidAdminDirRoleChange(uid) {
      return uid != request.auth.uid
        && resource.data.role in ['admin', 'superadmin']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
        && request.resource.data.role in ['admin', 'superadmin']
        && request.resource.data.role != resource.data.role
        && isRecentServerTime(request.resource.data.updatedAt);
    }
    function isValidLastLoginUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin'])
        && isRecentServerTime(request.resource.data.lastLogin);
    }
    // WB/Pengajar boleh ubah nomor HP sendiri (ProfilWB) — field lain tetap terkunci.
    function isValidSelfContactUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['noHp', 'updatedAt'])
        && request.resource.data.noHp is string && request.resource.data.noHp.size() <= 30
        && isRecentServerTime(request.resource.data.updatedAt);
    }
    // WB menyunting profilnya sendiri (halaman Profil): semua biodata + paket + tahunAngkatan
    // + nik boleh berubah. Yang DIKUNCI: status keanggotaan, email login, nomorInduk,
    // role/kd_role/createdAt/lastLogin. Bentuk dokumen tetap divalidasi isValidWBProfileShape.
    function isValidWBSelfProfileUpdate(uid) {
      return isOwner(uid)
        && resource.data.role == 'wb'
        && request.resource.data.role == resource.data.role
        && request.resource.data.kd_role == resource.data.kd_role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == resource.data.status
        && request.resource.data.email == resource.data.email
        && (('nomorInduk' in resource.data.keys()) == ('nomorInduk' in request.resource.data.keys()))
        && (!('nomorInduk' in resource.data.keys()) || request.resource.data.nomorInduk == resource.data.nomorInduk)
        && (('lastLogin' in resource.data.keys()) == ('lastLogin' in request.resource.data.keys()))
        && (!('lastLogin' in resource.data.keys()) || request.resource.data.lastLogin == resource.data.lastLogin)
        && isValidWBProfileShape(request.resource.data)
        && isRecentServerTime(request.resource.data.updatedAt);
    }
    function isValidAuditLog(data) {
      return data.keys().hasOnly(['action', 'module', 'targetId', 'targetType', 'performedBy', 'performedByName', 'performedByEmail', 'timestamp', 'metadata'])
        && data.keys().hasAll(['action', 'module', 'targetId', 'targetType', 'performedBy', 'performedByName', 'performedByEmail', 'timestamp', 'metadata'])
        && data.action in ['CREATE', 'UPDATE', 'DELETE', 'ACTIVATE', 'DEACTIVATE', 'UPDATE_STATUS', 'LOGIN', 'LOGOUT']
        && data.module is string && data.module.size() > 0 && data.module.size() <= 40
        && data.targetId is string && data.targetId.size() > 0 && data.targetId.size() <= 128
        && data.targetType is string && data.targetType.size() > 0 && data.targetType.size() <= 40
        && data.performedBy == request.auth.uid && data.performedByName is string && data.performedByName.size() <= 100
        && data.performedByEmail is string && data.performedByEmail.size() <= 254
        && isRecentServerTime(data.timestamp) && data.metadata is map && data.metadata.size() <= 8;
    }
    // Bentuk dokumen berita dipisah dari cek waktu server supaya bisa dipakai ulang
    // untuk create (createdAt baru) dan update (createdAt & author dikunci).
    function isValidNewsShape(data) {
      return data.keys().hasOnly(['title', 'deskripsi', 'tipeMedia', 'mediaType', 'mediaUrl', 'mediaBase64', 'author', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['title', 'deskripsi', 'tipeMedia', 'author', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.deskripsi is string && data.deskripsi.size() > 0 && data.deskripsi.size() <= 3000
        && data.author is string && data.author.size() <= 100
        && data.tipeMedia in ['gambar', 'video']
        && (
          (data.tipeMedia == 'video'
            && data.mediaUrl is string && data.mediaUrl.size() > 0 && data.mediaUrl.size() <= 500
            && !('mediaBase64' in data.keys()) && !('mediaType' in data.keys()))
          || (data.tipeMedia == 'gambar' && data.mediaType in ['upload', 'url']
            && (
              (data.mediaType == 'url'
                && data.mediaUrl is string && data.mediaUrl.size() > 0 && data.mediaUrl.size() <= 500
                && !('mediaBase64' in data.keys()))
              || (data.mediaType == 'upload'
                && data.mediaBase64 is string && data.mediaBase64.size() > 0 && data.mediaBase64.size() <= 900000
                && !('mediaUrl' in data.keys()))
            ))
        );
    }
    function isValidNewsDoc(data) {
      return isValidNewsShape(data) && isRecentServerTime(data.createdAt) && isRecentServerTime(data.updatedAt);
    }
    function isValidNewsUpdate() {
      return isValidNewsShape(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.author == resource.data.author
        && isRecentServerTime(request.resource.data.updatedAt);
    }
    // Bentuk dokumen mapel/jadwal dipisah dari cek createdAt/updatedAt supaya bisa dipakai ulang
    // baik untuk create (createdAt harus baru) maupun update (createdAt dikunci, updatedAt baru).
    function isValidMapelShape(data) {
      return data.keys().hasAll(['nama', 'paket', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['nama', 'paket', 'kode', 'createdAt', 'updatedAt'])
        && data.nama is string && data.nama.size() > 0 && data.nama.size() <= 100
        && data.paket in ['Paket A', 'Paket B', 'Paket C']
        // kode mapel opsional (mapel lama belum punya); auto-generate saat create/edit.
        && (!('kode' in data.keys()) || (data.kode is string && data.kode.size() > 0 && data.kode.size() <= 12));
    }
    function isValidMapelCreate(data) {
      return isValidMapelShape(data) && isRecentServerTime(data.createdAt) && isRecentServerTime(data.updatedAt);
    }
    function isValidMapelUpdate() {
      return isValidMapelShape(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && isRecentServerTime(request.resource.data.updatedAt);
    }
    // Tugas menempel pada satu mapel (mapelId/mapelNama/paket didenormalisasi dari
    // subjects). Input inti: judul + link file Google Drive (URL http/https).
    function isValidTugasShape(data) {
      return data.keys().hasAll(['mapelId', 'mapelNama', 'paket', 'judul', 'linkFile', 'author', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['mapelId', 'mapelNama', 'paket', 'judul', 'linkFile', 'author', 'createdAt', 'updatedAt'])
        && data.mapelId is string && data.mapelId.size() > 0 && data.mapelId.size() <= 128
        && data.mapelNama is string && data.mapelNama.size() > 0 && data.mapelNama.size() <= 100
        && data.paket in ['Paket A', 'Paket B', 'Paket C']
        && data.judul is string && data.judul.size() > 0 && data.judul.size() <= 200
        && data.linkFile is string && data.linkFile.size() > 0 && data.linkFile.size() <= 500
        && data.linkFile.matches('^https?://.*')
        && data.author is string && data.author.size() <= 100;
    }
    function isValidTugasCreate(data) {
      return isValidTugasShape(data) && isRecentServerTime(data.createdAt) && isRecentServerTime(data.updatedAt);
    }
    function isValidTugasUpdate() {
      return isValidTugasShape(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.author == resource.data.author
        && isRecentServerTime(request.resource.data.updatedAt);
    }
    function isValidJadwalShape(data) {
      return data.keys().hasAll(['namaMapel', 'hari', 'jamMulai', 'jamSelesai', 'pengajar', 'paket', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['namaMapel', 'hari', 'jamMulai', 'jamSelesai', 'pengajar', 'paket', 'createdAt', 'updatedAt'])
        && data.namaMapel is string && data.namaMapel.size() > 0 && data.namaMapel.size() <= 100
        && data.hari in ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Minggu']
        && data.jamMulai is string && data.jamMulai.size() <= 8
        && data.jamSelesai is string && data.jamSelesai.size() <= 8
        && data.pengajar is string && data.pengajar.size() <= 100
        && data.paket in ['Paket A', 'Paket B', 'Paket C'];
    }
    function isValidJadwalCreate(data) {
      return isValidJadwalShape(data) && isRecentServerTime(data.createdAt) && isRecentServerTime(data.updatedAt);
    }
    function isValidJadwalUpdate() {
      return isValidJadwalShape(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && isRecentServerTime(request.resource.data.updatedAt);
    }
    function isValidLatLng(data) {
      return data is map && data.keys().hasOnly(['lat', 'lng']) && data.keys().hasAll(['lat', 'lng'])
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180;
    }
    // Dasar field yang selalu ada di setiap dokumen presensi, baik dicatat admin (manual,
    // tanpa sesi/foto) maupun WB sendiri (wajib sesi kelas aktif + foto + lokasi).
    function isValidPresensiBase(data) {
      return data.wbId is string && data.wbId.size() > 0
        && data.nama is string && data.nama.size() > 0 && data.nama.size() <= 100
        && data.status in ['Hadir', 'Izin', 'Sakit', 'Alpa']
        && data.tanggal is string && data.tanggal.size() == 10
        && data.recordedBy == request.auth.uid
        && isRecentServerTime(data.createdAt);
    }
    function isValidAdminPresensiDoc(data) {
      return data.keys().hasAll(['wbId', 'nama', 'status', 'tanggal', 'recordedBy', 'createdAt'])
        && data.keys().hasOnly(['wbId', 'nama', 'status', 'tanggal', 'recordedBy', 'createdAt'])
        && isValidPresensiBase(data);
    }
    // Presensi mandiri WB: hanya boleh menandai diri sendiri Hadir, wajib terhubung ke
    // classSessions yang masih aktif (belum lewat durasiMenit sejak startedAt), wajib foto+lokasi.
    function isValidSelfCheckinDoc(data) {
      return data.keys().hasAll(['wbId', 'nama', 'status', 'tanggal', 'sessionId', 'namaMapel', 'lokasi', 'fotoBase64', 'mode', 'recordedBy', 'createdAt'])
        && data.keys().hasOnly(['wbId', 'nama', 'status', 'tanggal', 'sessionId', 'namaMapel', 'lokasi', 'fotoBase64', 'mode', 'recordedBy', 'createdAt'])
        && isValidPresensiBase(data)
        && data.status == 'Hadir'
        && data.wbId == request.auth.uid
        && data.sessionId is string && data.sessionId.size() > 0
        && data.namaMapel is string && data.namaMapel.size() > 0 && data.namaMapel.size() <= 100
        && isValidLatLng(data.lokasi)
        && data.fotoBase64 is string && data.fotoBase64.size() > 0 && data.fotoBase64.size() <= 900000
        && data.mode in ['luring', 'daring']
        // Presensi LURING wajib di area PKBM. Rentang = 5 titik lembaga + toleransi GPS
        // (samakan dengan src/utils/presensiLokasi.js jika diubah).
        && (data.mode != 'luring' || (
             data.lokasi.lat >= -8.3067194 && data.lokasi.lat <= -8.3058528
             && data.lokasi.lng >= 113.68685 && data.lokasi.lng <= 113.68765
           ))
        && isClassSessionActive(data.sessionId);
    }
    // Sesi dianggap aktif kalau belum distop manual DAN belum lewat durasinya.
    function isClassSessionActive(sessionId) {
      let session = get(/databases/$(database)/documents/classSessions/$(sessionId)).data;
      return !('stoppedAt' in session.keys())
        && request.time < session.startedAt + duration.value(session.durasiMenit, 'm');
    }
    // Sesi kelas dibuat pengajar lewat "Mulai Mengajar" — sekaligus jadi bukti kehadiran pengajar
    // (foto+lokasi wajib). ID dokumen deterministik {scheduleId}_{tanggal} dari client, jadi cukup
    // dicek pengajarId == auth.uid; keunikan per hari dijaga lewat transaksi create-if-absent di client.
    function isValidClassSessionDoc(data) {
      return data.keys().hasAll(['scheduleId', 'namaMapel', 'paket', 'hari', 'tanggal', 'durasiMenit', 'pengajarId', 'pengajarNama', 'lokasi', 'fotoBase64', 'startedAt'])
        && data.keys().hasOnly(['scheduleId', 'namaMapel', 'paket', 'hari', 'tanggal', 'durasiMenit', 'pengajarId', 'pengajarNama', 'lokasi', 'fotoBase64', 'startedAt'])
        && data.scheduleId is string && data.scheduleId.size() > 0
        && data.namaMapel is string && data.namaMapel.size() > 0 && data.namaMapel.size() <= 100
        && data.paket in ['Paket A', 'Paket B', 'Paket C']
        && data.hari in ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Minggu']
        && data.tanggal is string && data.tanggal.size() == 10
        && data.durasiMenit is number && data.durasiMenit > 0 && data.durasiMenit <= 600
        && data.pengajarId == request.auth.uid
        && data.pengajarNama is string && data.pengajarNama.size() > 0 && data.pengajarNama.size() <= 100
        && isValidLatLng(data.lokasi)
        && data.fotoBase64 is string && data.fotoBase64.size() > 0 && data.fotoBase64.size() <= 900000
        && isRecentServerTime(data.startedAt);
    }
    // Pengajar tap "Stop" sebelum durasi habis — cuma boleh sekali (stoppedAt belum ada),
    // cuma pemilik sesi, cuma field itu yang berubah.
    function isValidSessionStop() {
      return isPengajar() && resource.data.pengajarId == request.auth.uid
        && !('stoppedAt' in resource.data.keys())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stoppedAt'])
        && isRecentServerTime(request.resource.data.stoppedAt);
    }
    // Finalisasi sesi (tandai WB yang tidak presensi jadi Alpa) — cuma sekali (finalizedAt belum ada),
    // cuma pemilik sesi, dan cuma boleh setelah sesi benar2 berakhir (distop manual atau durasi habis).
    function isValidSessionFinalize() {
      return isPengajar() && resource.data.pengajarId == request.auth.uid
        && !('finalizedAt' in resource.data.keys())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finalizedAt'])
        && isRecentServerTime(request.resource.data.finalizedAt)
        && (('stoppedAt' in resource.data.keys())
            || request.time >= resource.data.startedAt + duration.value(resource.data.durasiMenit, 'm'));
    }
    // Finalisasi otomatis menandai WB yang tidak presensi sebagai Alpa — bukan self-checkin
    // (bukan WB yang menulis), jadi tanpa foto/lokasi, hanya pengajar pemilik sesi yang boleh.
    function isValidPengajarAbsentDoc(data) {
      return data.keys().hasAll(['wbId', 'nama', 'status', 'tanggal', 'sessionId', 'namaMapel', 'recordedBy', 'createdAt'])
        && data.keys().hasOnly(['wbId', 'nama', 'status', 'tanggal', 'sessionId', 'namaMapel', 'recordedBy', 'createdAt'])
        && isValidPresensiBase(data)
        && data.status == 'Alpa'
        && data.sessionId is string && data.sessionId.size() > 0
        && data.namaMapel is string && data.namaMapel.size() > 0 && data.namaMapel.size() <= 100
        && isPengajarOfSession(data.sessionId);
    }
    function isValidInvoiceDoc(data) {
      return data.keys().hasAll(['wbId', 'nama', 'keterangan', 'jumlah', 'jatuhTempo', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['wbId', 'nama', 'keterangan', 'jumlah', 'jatuhTempo', 'status', 'createdAt', 'updatedAt'])
        && data.wbId is string && data.wbId.size() > 0
        && data.nama is string && data.nama.size() > 0 && data.nama.size() <= 100
        && data.keterangan is string && data.keterangan.size() > 0 && data.keterangan.size() <= 200
        && data.jumlah is number && data.jumlah >= 0
        && data.jatuhTempo is string && data.jatuhTempo.size() == 10
        && data.status in ['LUNAS', 'BELUM_LUNAS']
        && isRecentServerTime(data.createdAt) && isRecentServerTime(data.updatedAt);
    }
    function isValidInvoiceStatusUpdate() {
      return isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['LUNAS', 'BELUM_LUNAS']
        && isRecentServerTime(request.resource.data.updatedAt);
    }
    // --- PENDAFTARAN CALON WB (alur: bayar 48 jam → verifikasi → lengkapi profil → aktivasi) ---
    function isValidRegDataDiri(data) {
      return data.namaLengkap is string && data.namaLengkap.size() > 1 && data.namaLengkap.size() <= 100
        && data.email is string && data.email.size() > 4 && data.email.size() <= 254
        && data.noHp is string && data.noHp.size() > 0 && data.noHp.size() <= 30
        && data.nik is string && data.nik.size() > 0 && data.nik.size() <= 30
        && data.nisn is string && data.nisn.size() <= 30
        && data.tempatLahir is string && data.tempatLahir.size() > 0 && data.tempatLahir.size() <= 100
        && data.tanggalLahir is string && data.tanggalLahir.size() == 10
        && data.jenisKelamin in ['L', 'P']
        && data.alamat is string && data.alamat.size() > 0 && data.alamat.size() <= 500;
    }
    function isValidRegistrationCreate(data) {
      return data.keys().hasOnly(['namaLengkap', 'email', 'noHp', 'nik', 'nisn', 'tempatLahir', 'tanggalLahir', 'jenisKelamin', 'alamat', 'status', 'deadlineAt', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['namaLengkap', 'email', 'noHp', 'nik', 'nisn', 'tempatLahir', 'tanggalLahir', 'jenisKelamin', 'alamat', 'status', 'deadlineAt', 'createdAt', 'updatedAt'])
        && isValidRegDataDiri(data)
        && data.status == 'MENUNGGU_PEMBAYARAN'
        && data.deadlineAt is timestamp && data.deadlineAt > request.time
        && isRecentServerTime(data.createdAt) && isRecentServerTime(data.updatedAt);
    }
    function regDiff() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // Calon unggah bukti bayar (masih dalam masa 48 jam) → status MENUNGGU_VERIFIKASI.
    function isValidOwnPaymentUpload() {
      return resource.data.status == 'MENUNGGU_PEMBAYARAN'
        && request.time < resource.data.deadlineAt
        && regDiff().hasOnly(['paymentProof', 'rejectionReason', 'status', 'updatedAt'])
        && request.resource.data.status == 'MENUNGGU_VERIFIKASI'
        && request.resource.data.paymentProof.base64 is string
        && request.resource.data.paymentProof.base64.size() > 0
        && request.resource.data.paymentProof.base64.size() <= 900000
        && isRecentServerTime(request.resource.data.updatedAt);
    }
    // Calon melengkapi data lanjutan setelah pembayaran diverifikasi (status LUNAS).
    function isValidOwnProfileCompletion() {
      return resource.data.status == 'LUNAS'
        && request.resource.data.status == 'LUNAS'
        && regDiff().hasOnly(['namaLengkap', 'noHp', 'nik', 'nisn', 'tempatLahir', 'tanggalLahir', 'jenisKelamin', 'alamat', 'namaWali', 'noHpWali', 'program', 'dokumen', 'profileCompletedAt', 'updatedAt'])
        && request.resource.data.namaWali is string && request.resource.data.namaWali.size() > 1 && request.resource.data.namaWali.size() <= 100
        && request.resource.data.noHpWali is string && request.resource.data.noHpWali.size() > 0 && request.resource.data.noHpWali.size() <= 30
        && request.resource.data.program in ['Paket A', 'Paket B', 'Paket C']
        && request.resource.data.dokumen.pasFoto.base64 is string && request.resource.data.dokumen.pasFoto.base64.size() <= 900000
        && request.resource.data.dokumen.dokumenPendukung.base64 is string && request.resource.data.dokumen.dokumenPendukung.base64.size() <= 900000
        && isValidRegDataDiri(request.resource.data)
        && isRecentServerTime(request.resource.data.updatedAt);
    }
    // Countdown habis tanpa bukti bayar → calon (atau AuthContext) menandai KEDALUWARSA.
    function isValidOwnExpiry() {
      return resource.data.status == 'MENUNGGU_PEMBAYARAN'
        && request.time >= resource.data.deadlineAt
        && regDiff().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'KEDALUWARSA'
        && isRecentServerTime(request.resource.data.updatedAt);
    }
    function isValidRegVerifyPayment() {
      return resource.data.status == 'MENUNGGU_VERIFIKASI'
        && regDiff().hasOnly(['status', 'paymentVerifiedBy', 'paymentVerifiedAt', 'updatedAt'])
        && request.resource.data.status == 'LUNAS'
        && request.resource.data.paymentVerifiedBy == request.auth.uid
        && isRecentServerTime(request.resource.data.paymentVerifiedAt)
        && isRecentServerTime(request.resource.data.updatedAt);
    }
    function isValidRegRejectPayment() {
      return resource.data.status == 'MENUNGGU_VERIFIKASI'
        && regDiff().hasOnly(['status', 'paymentProof', 'rejectionReason', 'updatedAt'])
        && request.resource.data.status == 'MENUNGGU_PEMBAYARAN'
        && !('paymentProof' in request.resource.data.keys())
        && request.resource.data.rejectionReason is string && request.resource.data.rejectionReason.size() <= 300
        && isRecentServerTime(request.resource.data.updatedAt);
    }
    function isValidRegReject() {
      return resource.data.status in ['MENUNGGU_PEMBAYARAN', 'MENUNGGU_VERIFIKASI', 'LUNAS', 'KEDALUWARSA']
        && regDiff().hasOnly(['status', 'rejectionReason', 'updatedAt'])
        && request.resource.data.status == 'DITOLAK'
        && request.resource.data.rejectionReason is string && request.resource.data.rejectionReason.size() <= 300
        && isRecentServerTime(request.resource.data.updatedAt);
    }
    function isValidRegActivate() {
      return resource.data.status == 'LUNAS'
        && ('profileCompletedAt' in resource.data.keys())
        && regDiff().hasOnly(['status', 'activatedBy', 'activatedAt', 'updatedAt'])
        && request.resource.data.status == 'DIAKTIFKAN'
        && request.resource.data.activatedBy == request.auth.uid
        && isRecentServerTime(request.resource.data.activatedAt)
        && isRecentServerTime(request.resource.data.updatedAt);
    }

    match /konten/{document} { allow read: if true; allow write: if false; }

    match /users/{uid} {
      // Pengajar boleh baca profil WB (nama+status saja yang dipakai) buat roster kehadiran
      // di Jadwal Mengajar — dibatasi resource.data.role == 'wb' jadi tidak bisa lihat admin/pengajar lain.
      allow get: if isOwner(uid) || isStaff() || (isPengajar() && resource.data.role == 'wb');
      allow list: if isStaff() || (isPengajar() && resource.data.role == 'wb');
      allow create: if (isSuperadmin() && isValidAdminProfile(request.resource.data))
        || (isStaff() && (
              (isValidWBProfile(request.resource.data) && 'nomorInduk' in request.resource.data.keys())
              || isValidPengajarProfile(request.resource.data)
           ))
        || (isOwner(uid) && isValidCalonWBProfile(request.resource.data));
      allow update: if (isOwner(uid) && isValidLastLoginUpdate())
        || (isOwner(uid) && isValidSelfContactUpdate())
        || isValidWBSelfProfileUpdate(uid)
        || (isSuperadmin() && isValidAdminStatusUpdate())
        || (isSuperadmin() && isValidAdminRoleChange(uid))
        || (isStaff() && isValidCalonToWBActivation())
        || isValidWBOrPengajarEdit();
      // Hapus dokumen profil WB/Pengajar mencabut akses aplikasi (lihat AuthContext).
      // Akun Firebase Auth di baliknya perlu dibersihkan manual / lewat Admin SDK.
      allow delete: if isStaff() && resource.data.role in ['wb', 'pengajar'];
    }

    // wbSecrets/{uid}: password login WB yang di-generate admin, disimpan supaya admin bisa
    // membacakannya kembali (WB lupa) & melakukan reset (re-auth sebagai WB di app sekunder
    // lalu updatePassword). HANYA staff yang boleh baca/tulis — WB tidak boleh baca miliknya.
    match /wbSecrets/{uid} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['pwd', 'nomorInduk', 'updatedAt'])
        && request.resource.data.keys().hasAll(['pwd', 'nomorInduk', 'updatedAt'])
        && request.resource.data.pwd is string && request.resource.data.pwd.size() >= 6 && request.resource.data.pwd.size() <= 64
        && request.resource.data.nomorInduk is string && request.resource.data.nomorInduk.size() >= 6 && request.resource.data.nomorInduk.size() <= 20
        && isRecentServerTime(request.resource.data.updatedAt);
      allow delete: if isStaff();
    }

    // wbNik/{nik}: indeks unik NIK -> uid. Karena "allow create" hanya berlaku saat
    // path belum ada, penulisan ke NIK yang sudah dipakai gagal (jadi "update", ditolak).
    // Ini penjaga keras terhadap Warga Belajar terdaftar dua kali.
    // Staff mengelola untuk siapa saja; WB hanya boleh entri yang menunjuk uid-nya sendiri
    // (dipakai saat WB mengganti NIK lewat halaman Profil).
    match /wbNik/{nik} {
      allow read: if isSignedIn();
      allow create: if (isStaff() || (isSignedIn() && request.resource.data.uid == request.auth.uid))
        && request.resource.data.keys().hasOnly(['uid', 'nik', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'nik', 'createdAt'])
        && request.resource.data.uid is string && request.resource.data.uid.size() > 0
        && request.resource.data.nik == nik
        && nik.matches('^[0-9]{16}$')
        && isRecentServerTime(request.resource.data.createdAt);
      allow update: if false;
      allow delete: if isStaff() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // wbPhotos/{uid}: pas foto WB (base64) dipisah dari dokumen users supaya daftar WB
    // tetap ringan. Hanya staff yang menulis; WB & pengajar boleh membaca.
    match /wbPhotos/{uid} {
      allow read: if isOwner(uid) || isStaff() || isPengajar();
      // Staff kelola foto siapa saja; WB kelola fotonya sendiri (halaman Profil).
      allow create, update: if (isStaff() || isOwner(uid))
        && request.resource.data.keys().hasOnly(['base64', 'updatedAt'])
        && request.resource.data.keys().hasAll(['base64', 'updatedAt'])
        && request.resource.data.base64 is string
        && request.resource.data.base64.size() > 0
        && request.resource.data.base64.size() <= 900000
        && isRecentServerTime(request.resource.data.updatedAt);
      allow delete: if isStaff() || isOwner(uid);
    }

    match /admins/{uid} {
      allow get, list: if isSuperadmin();
      allow create: if isSuperadmin() && isValidAdminDirectory(uid, request.resource.data);
      allow update: if (isOwner(uid) && isValidLastLoginUpdate())
        || (isSuperadmin() && isValidAdminStatusUpdate())
        || (isSuperadmin() && isValidAdminDirRoleChange(uid));
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow get, list: if isSuperadmin();
      allow create: if isSignedIn() && isValidAuditLog(request.resource.data);
      allow update, delete: if false;
    }

    match /news/{newsId} {
      allow get, list: if true;
      allow create: if isStaff() && isValidNewsDoc(request.resource.data);
      allow update: if isStaff() && isValidNewsUpdate();
      allow delete: if isStaff();
    }

    // Mapel & jadwal bukan data sensitif — semua pengguna yang login (WB/Pengajar/Staff) boleh baca.
    match /subjects/{subjectId} {
      allow get, list: if isSignedIn();
      allow create: if isStaff() && isValidMapelCreate(request.resource.data);
      allow update: if isStaff() && isValidMapelUpdate();
      allow delete: if isStaff();
    }

    match /schedules/{scheduleId} {
      allow get, list: if isSignedIn();
      allow create: if isStaff() && isValidJadwalCreate(request.resource.data);
      allow update: if isStaff() && isValidJadwalUpdate();
      allow delete: if isStaff();
    }

    // Tugas per mapel — dikelola staff, dibaca semua pengguna login (WB filter per paket).
    match /tugas/{tugasId} {
      allow get, list: if isSignedIn();
      allow create: if isStaff() && isValidTugasCreate(request.resource.data);
      allow update: if isStaff() && isValidTugasUpdate();
      allow delete: if isStaff();
    }

    // WB boleh baca & catat presensi sendiri (checkin mandiri di PresensiWB, wajib sesi aktif);
    // staff boleh mencatat manual (Izin/Sakit/Alpa/Hadir) untuk siapa saja tanpa sesi/foto.
    match /presensi/{presensiId} {
      allow get, list: if isStaff()
        || (isSignedIn() && resource.data.wbId == request.auth.uid)
        || (('sessionId' in resource.data.keys()) && isPengajarOfSession(resource.data.sessionId));
      allow create: if (isStaff() && isValidAdminPresensiDoc(request.resource.data))
        || (isSignedIn() && isValidSelfCheckinDoc(request.resource.data))
        || (isSignedIn() && isValidPengajarAbsentDoc(request.resource.data));
      allow update: if false;
      // Staff boleh menghapus baris rekap kehadiran WB (koreksi salah catat).
      allow delete: if isStaff();
    }

    // Sesi mengajar: pengajar "Mulai Mengajar" jadi bukti kehadirannya sendiri (foto+lokasi),
    // sekaligus membuka jendela waktu WB boleh presensi (lihat isClassSessionActive).
    // Update cuma dua jalur sempit: Stop manual (stoppedAt) dan finalisasi absensi (finalizedAt).
    match /classSessions/{sessionId} {
      allow get, list: if isSignedIn();
      allow create: if isPengajar() && isValidClassSessionDoc(request.resource.data);
      allow update: if isValidSessionStop() || isValidSessionFinalize();
      // Staff boleh menghapus sesi mengajar dari Rekap Kehadiran (koreksi salah catat).
      allow delete: if isStaff();
    }

    // WB boleh baca tagihan sendiri; hanya staff yang boleh membuat/mengubah status.
    match /invoices/{invoiceId} {
      allow get, list: if isStaff() || (isSignedIn() && resource.data.wbId == request.auth.uid);
      allow create: if isStaff() && isValidInvoiceDoc(request.resource.data);
      allow update: if isValidInvoiceStatusUpdate();
      allow delete: if false;
    }

    // Pendaftaran calon WB: dokumen di-key oleh Auth UID calon. Calon menulis sendiri
    // saat submit formulir & saat unggah bukti / lengkapi profil; staff yang memverifikasi
    // pembayaran, menolak, dan mengaktifkan (users/{uid} calon_wb -> wb).
    match /registrations/{regId} {
      allow get: if isOwner(regId) || isStaff();
      allow list: if isStaff();
      allow create: if isOwner(regId) && isValidRegistrationCreate(request.resource.data);
      allow update: if (isOwner(regId) && (isValidOwnPaymentUpload() || isValidOwnProfileCompletion() || isValidOwnExpiry()))
        || (isStaff() && (isValidRegVerifyPayment() || isValidRegRejectPayment() || isValidRegReject() || isValidRegActivate()));
      allow delete: if false;
    }

    // Antrean email untuk Firebase "Trigger Email from Firestore" extension.
    // Hanya staff yang boleh menulis; tidak ada yang boleh membaca dari client.
    match /mail/{mailId} {
      allow get, list: if false;
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['to', 'message'])
        && request.resource.data.to is string && request.resource.data.to.size() > 4 && request.resource.data.to.size() <= 254
        && request.resource.data.message.keys().hasOnly(['subject', 'html'])
        && request.resource.data.message.subject is string && request.resource.data.message.subject.size() <= 200
        && request.resource.data.message.html is string && request.resource.data.message.html.size() <= 20000;
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
